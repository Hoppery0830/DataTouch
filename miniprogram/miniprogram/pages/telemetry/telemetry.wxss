.page{padding:24rpx;background:#f3f6fa;min-height:100vh;color:#233247}.card{background:white;padding:24rpx;border-radius:18rpx;margin-bottom:20rpx;line-height:1.8;font-size:26rpx}.title{font-size:32rpx;font-weight:600;margin-bottom:12rpx}.muted{color:#748196;font-size:23rpx}.ok{color:#198357}.warn{color:#be651f}.select{padding:14rpx;background:#eef4ff;border-radius:12rpx;color:#2667d9}.canvas{width:100%;height:280px}.legend{font-size:22rpx;margin:12rpx 0}.row{display:flex;justify-content:space-between;border-bottom:1rpx solid #eef1f5;padding:8rpx 0}