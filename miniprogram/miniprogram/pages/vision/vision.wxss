.page { padding: 28rpx; background: #f6f7f9; min-height: 100vh; box-sizing: border-box; }
.title { font-size: 40rpx; font-weight: bold; margin-bottom: 16rpx; }
.hint { color: #687386; font-size: 24rpx; line-height: 1.7; }
.card { background: white; border-radius: 20rpx; padding: 28rpx; margin-top: 24rpx; }
.label { color: #435167; font-size: 28rpx; }
.value { font-size: 52rpx; color: #2458a6; margin: 12rpx 0; }
.token { font-size: 24rpx; word-break: break-all; margin-bottom: 12rpx; }
.error { color: #b33333; padding: 20rpx 0; }
.empty { padding: 60rpx 12rpx; color: #687386; line-height: 1.8; }
