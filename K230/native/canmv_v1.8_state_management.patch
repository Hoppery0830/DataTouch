diff --git a/port/core/main.c b/port/core/main.c
index 156fcce..136c888 100644
--- a/port/core/main.c
+++ b/port/core/main.c
@@ -86,6 +86,32 @@
 #define PATHLIST_SEP_CHAR ':'
 #define FORCED_EXIT (0x100)
 
+// A deliberate DataTouch mode switch leaves a one-shot marker before calling
+// machine.reset(). Consume it here so /sdcard/main.py can run once even while
+// the IDE remains attached. Normal IDE run-script resets do not have this
+// marker and therefore retain the upstream auto-exec suppression semantics.
+static bool datatouch_mode_auto_exec(void)
+{
+    char mode[16] = {0};
+    FILE *file = fopen(SDCARD_MOUNT "/datatouch_mode.txt", "r");
+    if (file == NULL) {
+        return false;
+    }
+    size_t length = fread(mode, 1, sizeof(mode) - 1, file);
+    fclose(file);
+    mode[length] = '\0';
+
+    bool valid_mode = strncmp(mode, "PRODUCTION", 10) == 0 || strncmp(mode, "DEBUG", 5) == 0;
+    const char *reset_flag = SDCARD_MOUNT "/.datatouch_mode_reset";
+    if (!valid_mode || access(reset_flag, F_OK) != 0) {
+        return false;
+    }
+
+    // A stale flag must never turn every future IDE soft reset into auto-exec.
+    unlink(reset_flag);
+    return true;
+}
+
 // Forward declarations
 
 MP_NOINLINE int main_(int argc, char **argv);
@@ -464,14 +490,12 @@ soft_reset:
     mp_hal_set_interrupt_char(-1);
     ide_dbg_clear_soft_reset_request();
 
-    // Auto-run boot.py/main.py immediately -- never block boot waiting for an IDE
-    // that may never connect. Only skip auto-exec if the IDE/extension is already
-    // attached right now (e.g. it stayed connected across a soft reset). If it
-    // attaches later while a script runs, the attach path soft-resets and
-    // ide_dbg_auto_exec_allowed() then keeps boot.py/main.py idle until hard reboot.
-    bool ide_connected = ide_dbg_is_connected();
+    // Auto-run boot.py/main.py regardless of whether an IDE transport is
+    // attached.  Auto-exec is suppressed only after an explicit SCRIPT_STOP
+    // debug takeover; connect/reconnect/heartbeat traffic is observational.
+    bool datatouch_auto_exec = datatouch_mode_auto_exec();
 
-    if (!is_repl_intr && !ide_connected && ide_dbg_auto_exec_allowed()) {
+    if (!is_repl_intr && (datatouch_auto_exec || ide_dbg_auto_exec_allowed())) {
         FILE*      script_file = NULL;
         const int* stage_ptr   = NULL;
         char*      script_str  = NULL;
@@ -493,7 +517,7 @@ soft_reset:
 
         // Process both boot.py and main/fallback scripts
         for (size_t i = 0; i < sizeof(scripts_to_run) / sizeof(scripts_to_run[0]); i++) {
-            if (ide_dbg_is_connected() || ide_dbg_has_script() || 0x00 != access(scripts_to_run[i], F_OK)) {
+            if (ide_dbg_has_script() || 0x00 != access(scripts_to_run[i], F_OK)) {
                 continue;
             }
 
